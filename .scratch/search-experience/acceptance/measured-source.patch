+// bestSearchField selects one independently matching field by the complete
+// field-level order. Choosing before row expansion avoids sorting four rows per
+// book with a window function; candidates already contain unique identities.
+// Each expansion binds eight copies of the normalized keyword.
+func bestSearchField(name, title string) string {
+	return `CASE WHEN instr(` + name + `,?)=0 THEN ` + title + `
+ WHEN instr(` + title + `,?)=0 THEN ` + name + `
+ WHEN ` + name + `=? THEN ` + name + ` WHEN ` + title + `=? THEN ` + title + `
+ WHEN instr(` + name + `,?)<instr(` + title + `,?) THEN ` + name + `
+ WHEN instr(` + name + `,?)>instr(` + title + `,?) THEN ` + title + `
+ WHEN length(` + name + `)<=length(` + title + `) THEN ` + name + ` ELSE ` + title + ` END`
+}
