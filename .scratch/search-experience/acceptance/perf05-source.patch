+		branches = append(branches, `SELECT st.`+id+` AS id,CASE WHEN st.`+field+`=? THEN 0 ELSE 1 END AS tier,
+ instr(st.`+field+`,?)-1 AS position,length(st.`+field+`)-length(?) AS extra
+ FROM (`+candidates+`) c JOIN `+table+` st ON st.`+id+`=c.id
+ WHERE instr(st.`+field+`,?)>0 AND (instr(st.`+other+`,?)=0 OR
+ (CASE WHEN st.`+field+`=? THEN 0 ELSE 1 END,instr(st.`+field+`,?),length(st.`+field+`)) `+cmp+`
+ (CASE WHEN st.`+other+`=? THEN 0 ELSE 1 END,instr(st.`+other+`,?),length(st.`+other+`)))`)
