# SQL 源文件强制使用 LF 换行。
# 原因：sqlc 的 SQLite 解析器在 CRLF + 多字节（中文注释）混合时会发生字节偏移错位，
# 导致查询名被截断、生成失败。在 core.autocrlf=true 的 Windows 检出上尤其明显。
# 强制 LF 可让 sqlc generate 在任何环境下稳定工作。
*.sql text eol=lf

# Keep legal texts byte-exact for the notice inventory's SHA-256 checks.
LICENSE -text
NOTICE -text
# Upstream license files can intentionally end with blank lines; preserve their bytes.
LICENSES/** -text whitespace=-blank-at-eof

# Keep generated review mockups and Python fixture recipes LF-clean across worktrees.
.thinkrail/context/mockups/*.html text eol=lf
internal/parser/testdata/*.py text eol=lf

# CHANGELOG 统一 LF：编辑工具写回时不会再把整篇换行改掉，发布工作流按行截取 Release 正文。
CHANGELOG.md text eol=lf
